{
  "name": "ws-ecomm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "bun --env-file=.env.local --bun x drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local --bun x drizzle-kit migrate",
    "db:setup": "bun --env-file=.env.local scripts/setup-db.ts",
    "auth:generate": "JITI_FS_CACHE=false bun --env-file=.env.local --bun x auth generate --cwd scripts/auth-cli --config ../../lib/auth.ts --output ../../lib/auth-schema.ts --yes",
    "seed:staff": "bun --env-file=.env.local scripts/seed-staff.ts",
    "seed:content": "bun --env-file=.env.local scripts/seed-content.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.27",
    "@number-flow/react": "0.6.2",
    "@vercel/functions": "3.11.3",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "nuqs": "2.10.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "yet-another-react-lightbox": "3.33.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.27",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.3.1",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "esbuild": "0.25.12"
  }
}
